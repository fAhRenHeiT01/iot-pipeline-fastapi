# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Confluent Cloud Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_API_KEY=your_kafka_api_key
KAFKA_API_SECRET=your_kafka_api_secret
KAFKA_TOPIC_RAW=fleet.telemetry.raw

# Databricks Lakehouse & SQL Warehouse
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_personal_access_token
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id
DATABRICKS_CATALOG=fleet_iot
DATABRICKS_SCHEMA=telemetry

# SLA & Data Processing
SLA_MAX_LATENCY_SECONDS=120
WATERMARK_DURATION_MINUTES=15
CHECKPOINT_BASE_PATH=/tmp/checkpoints/fleet_iot

# Local PySpark & Lakehouse Settings
DATABASE_BACKEND=sqlite
SQLITE_DB_PATH=data/fleet_local.db
LOCAL_CHECKPOINT_DIR=data/checkpoints
LOCAL_LAKEHOUSE_DIR=data/lakehouse
JAVA_HOME=C:\Users\username\.jdks\openjdk-19.0.1
# HADOOP_HOME=hadoop

